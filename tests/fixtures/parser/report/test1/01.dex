program teste1
{* Calculo de perimetro e area *}
base, altura : float;
perimetro : float;
area, la is float;
begin
write("Entre com a altura do retangulo:");
read(altura);
write("Entre com a base do retangulo:");
read(base);
area = base * altura;
perimetro = 2 * base + 2 * altura;
write "Area: ";
write(area);
write("Perimetro: ");
write(area)
end.
